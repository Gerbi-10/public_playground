# Template only — DO NOT put real values here. This repo is PUBLIC.
#
# In production these are supplied as platform secrets at runtime via
# /run/base44/app.env (outside the repo, outside git).
# For local development only, copy this file to .env (which is gitignored).

# "openai" or "anthropic"
LLM_PROVIDER=

# The provider API key. NEVER commit a real value.
LLM_API_KEY=

# Optional. Defaults: openai -> gpt-4o-mini, anthropic -> claude-3-5-haiku-latest
LLM_MODEL=
